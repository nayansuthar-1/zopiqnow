<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The colour of the launch window, before Flutter has drawn anything.

      It mirrors ZopiqPalette.primaryDeep (#FF5200), which is what SplashPage
      paints itself and what the launcher icon's own background is. Neither
      Android nor iOS can read a Dart token, so this value is written three
      times — here, in the Dart palette, and as sRGB components in
      ios/Runner/Base.lproj/LaunchScreen.storyboard. Change them together or the
      handover from the system splash to the first Flutter frame becomes two
      oranges that nearly match, which is more noticeable than two that do not.
    -->
    <color name="zopiq_splash_background">#FF5200</color>
</resources>
