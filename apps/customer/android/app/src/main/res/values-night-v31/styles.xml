<?xml version="1.0" encoding="utf-8"?>
<!--
  The dark-mode twin of values-v31/styles.xml.

  The splash is brand and does not have a dark variant: a customer who opens the
  app in dark mode gets the same orange, because the alternative is the icon's
  background and the launch screen disagreeing about what the app looks like.
  Only the parent theme differs, matching values-night/.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/zopiq_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
