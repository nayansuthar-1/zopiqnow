<?xml version="1.0" encoding="utf-8"?>
<!--
  API 21+ launch window. Was `?android:colorBackground`, which resolves to the
  system's window colour — white in light mode, black in dark — and is what put
  a flash of the wrong colour in front of an orange splash.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/zopiq_splash_background" />
</layer-list>
