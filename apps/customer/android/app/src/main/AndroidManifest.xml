<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required to load restaurant and dish imagery, and to reach the API.
         Flutter declares this for debug builds only; without it here, release
         builds fail every network image silently. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Delivery-address detection, foreground only. COARSE alone places the
         user within ~1-2km, which picks the wrong neighbourhood in a city;
         FINE is what makes "Banjara Hills" possible rather than "Hyderabad".
         On Android 12+ the user may grant COARSE only — geolocator reports that
         as `whileInUse` and the reverse-geocode still works, just fuzzier.

         ACCESS_BACKGROUND_LOCATION is deliberately NOT declared: we resolve an
         address while the picker is open and never track. Declaring it would
         trigger Play's background-location review for a feature we do not have
         (Rule 1.7). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Android 13+ makes notifications an opt-in the user must grant. Without
         this the customer is never asked, and an order-update push is silent. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- `allowBackup="false"` below: Android's auto-backup would copy this app's
         shared preferences to the user's Drive, and `flutter_secure_storage` keeps
         the session there as ciphertext whose key lives in the device Keystore.
         The key does not travel; the ciphertext would. Restoring onto a new phone
         then yields bytes nothing can open — a silently signed-out app at best, a
         crash loop at worst. A session is re-established by signing in, not
         carried in a backup, so opting out is the honest position rather than a
         precaution. -->
    <application
        android:label="Zopiq"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">

        <!-- The Maps SDK reads its key from here and nowhere else. The value is
             substituted by Gradle from `android/local.properties`, which is
             gitignored — see app/build.gradle.kts. Empty when unset, which
             renders Google's "authorization failure" tile rather than crashing. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- The channel a background FCM notification lands on when the payload
             names none. Must match the channel PushService creates in Dart
             (`order_updates`), or Android 8+ drops the notification silently. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="order_updates" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Android 11 (API 30) hides other apps from this one unless they are
             declared here. Without this, `canLaunchUrl` returns false on every
             modern phone and the Call buttons silently do nothing — the failure
             looks like a bug in our code and is not one. The rider app has
             carried the same declaration since 8g. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>

        <!-- The profile photo's camera path. Same Android 11 visibility rule as
             the dialler above: `image_picker` declares a FileProvider but no
             `<queries>` of its own, so a camera app this one cannot see is a
             camera app it may fail to resolve on stricter OEM builds.

             Note what is deliberately *not* here: `android.permission.CAMERA`.
             Declaring it would oblige us to request a runtime grant before
             ACTION_IMAGE_CAPTURE; leaving it out means the camera app takes the
             photo under its own permission and hands us back the result. Fewer
             permissions on the Play listing, and one less dialog. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
    </queries>
</manifest>
