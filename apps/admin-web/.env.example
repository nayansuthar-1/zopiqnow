# Copy to .env.local and fill from the repo-root .env.
# Anon key only — the service-role key must never reach the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# A *browser* key for the Maps JavaScript API, used by the map picker on the
# restaurant's address step. Optional: without it the console falls back to the
# two typed coordinate fields and says so.
#
# It must NOT be the Android key from apps/customer/android/local.properties.
# That one is destined to be restricted to the three app package names (ship
# item G11), and the day that happens a browser using it stops working. Make a
# second key in Cloud project 789936942272, enable "Maps JavaScript API" on it,
# and restrict it by HTTP referrer to wherever this console is served.
VITE_GOOGLE_MAPS_BROWSER_KEY=
