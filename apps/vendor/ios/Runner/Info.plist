<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- "Partner", not "Vendor", to match `android:label` in AndroidManifest.xml.
	     The restaurant sees this word on their own home screen; the repo calls
	     the app `zopiq_vendor` internally and always has. -->
	<key>CFBundleDisplayName</key>
	<string>Zopiq Partner</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>zopiq_vendor</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ===================================================================
	     The iOS counterpart of AndroidManifest.xml — and the shortest of the
	     three, because this app's manifest is the shortest too. No location,
	     no maps, no Google sign-in: a kitchen screen takes orders and uploads
	     photographs of food.
	     =================================================================== -->

	<!-- image_picker, for two different kinds of picture, which is why this app
	     keeps both keys where the rider app now keeps only the camera one:

	       * the order photo is **evidence**, camera-only, and never reaches the
	         library (ProofPhotoField in `zopiq_uploads`);
	       * a dish or restaurant photo is an **illustration**, and choosing the
	         good shot of the biryani from the roll is exactly right for it.

	     iOS resolves these when the picker is constructed rather than when a
	     source is chosen, so both are required as long as either route exists.
	     NSPhotoLibraryAddUsageDescription is deliberately absent — we read a
	     photo and never write one back. -->
	<key>NSCameraUsageDescription</key>
	<string>Zopiq Partner needs the camera so you can photograph your dishes, and photograph each order as it is packed.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Zopiq Partner needs your photo library so you can choose dish and restaurant photos.</string>

	<!-- POST_NOTIFICATIONS has no plist counterpart; the prompt is a runtime
	     call the app already makes. This is the half with no Android analogue:
	     without `remote-notification` a data-only FCM message never reaches a
	     suspended app, and a new order landing in a pocket is exactly that. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>

	<!-- Native Google sign-in. `GIDClientID` is the *iOS* OAuth client; the web
	     client in `Env.googleWebClientId` is the `serverClientId` and stays
	     where it is. The URL scheme is that same id reversed, and is how Safari
	     hands the result back to the app. Both come from Secrets.xcconfig.

	     Without these the plugin finds no client id in any of the four places it
	     looks and `authenticate()` cannot succeed -- see IOS_HANDOVER.md 0.1.
	     Email OTP is unaffected either way. -->
	<key>GIDClientID</key>
	<string>$(GOOGLE_IOS_CLIENT_ID)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_IOS_URL_SCHEME)</string>
			</array>
		</dict>
	</array>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
