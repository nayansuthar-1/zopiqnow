<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Flutter's template declares INTERNET only in the *debug* manifest, so a
         release build ships without it and every request fails silently. The
         customer app learned this the hard way (Step 3). This app is nothing but
         requests. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+ makes notifications an opt-in the user must grant. Without
         this the kitchen never gets asked, and a new-order push is silent. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- See the customer app's manifest for the reasoning: a Keystore-backed
         session survives a Drive backup as ciphertext whose key does not, so a
         restored device would hold bytes nothing can open. -->
    <!-- Targeting API 36 (Android 16) turns predictive back on by default.
         Declared here rather than inherited, so the gesture is something these
         apps opted into rather than a behaviour that arrived with an SDK bump.
         Nothing overrides back in any of the three — no PopScope, no
         WillPopScope — so there is nothing for it to break. -->
    <application
        android:label="Zopiq Partner"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- The channel a background FCM notification lands on when the payload
             names none. Must match the channel the app creates in Dart
             (NotificationService._channel), or Android 8+ drops the notification. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="new_orders" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- The dish photo and the order photo both reach for the camera, and
             the order photo has nowhere else to go: the proof field is
             camera-only now, so a camera app this app cannot see is a kitchen
             that cannot mark an order ready. Android 11 (API 30) hides other
             apps unless they are declared here, and `image_picker` ships no
             `<queries>` of its own — on stricter OEM builds that is a failure
             which looks like a bug in our code and is not one.

             Note what is deliberately *not* here: `android.permission.CAMERA`.
             Declaring it would oblige us to request a runtime grant before
             ACTION_IMAGE_CAPTURE; leaving it out means the camera app takes the
             photo under its own permission and hands us back the result. The
             customer app has carried exactly this pair of decisions since A4. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
    </queries>
</manifest>
