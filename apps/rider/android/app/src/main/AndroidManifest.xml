<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Every screen in this app is a network call: the board, the claim, the
         pickup code, the sign-in email. Without this the app installs, opens,
         and fails at the first request with no useful message.

         Flutter's template declares INTERNET only in the debug and profile
         manifests, which is why this was invisible for four phases — every
         `flutter run` worked and every release APK was dead. The customer and
         vendor apps already carry it here; the rider app was created later and
         nobody had run its release build on a real phone until now. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 13+ makes notifications an opt-in the user must grant. Without
         this the rider is never asked, and a new-job push is silent. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- The customer's live map (B3). Asked for at the moment the rider first
         picks a bag up, not at launch — a permission dialog makes sense to
         somebody who has just accepted a delivery and makes none to somebody
         opening an app for the first time.

         COARSE as well as FINE because Android 12+ lets the user grant only the
         approximate one, and an approximate dot on a map is still a better
         answer than a blank one. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- The location stream keeps running while the rider is in Google Maps
         (audit RID-001).

         Without these the app was `whileInUse` and nothing else, and Android
         throttles a `whileInUse` app's location to a handful of fixes an hour
         once it leaves the foreground — on Android 10+ usually to none at all.
         The product's own happy path put it there: accept, tap Navigate, and
         Maps comes up over us. The customer's map froze for the whole journey
         and the ETA in `orders.eta_at` (0057) drifted off a stale fix.

         Still deliberately NOT ACCESS_BACKGROUND_LOCATION. That grant is for an
         app collecting position with nothing on screen and no notification, and
         it carries a Play review we would rightly lose. A foreground service
         with a visible ongoing notification is the sanctioned way to do this and
         needs no background grant at all: the rider can see, for the whole time
         it runs, that we are sharing their location. FOREGROUND_SERVICE_LOCATION
         is separately mandatory from Android 14. WAKE_LOCK is what
         `enableWakeLock` in the reporter's notification config acquires — the
         geolocator service calls `newWakeLock` unguarded, so the permission is
         not optional if that flag is on. The service itself is declared by the
         geolocator plugin's own manifest, already with
         `foregroundServiceType="location"`. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- See the customer app's manifest for the reasoning: a Keystore-backed
         session survives a Drive backup as ciphertext whose key does not, so a
         restored device would hold bytes nothing can open. -->
    <!-- Targeting API 36 (Android 16) turns predictive back on by default.
         Declared here rather than inherited, so the gesture is something these
         apps opted into rather than a behaviour that arrived with an SDK bump.
         Nothing overrides back in any of the three — no PopScope, no
         WillPopScope — so there is nothing for it to break. -->
    <application
        android:label="Zopiq Rider"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true">

        <!-- The Maps SDK reads its key from here and nowhere else. Substituted
             by Gradle from `android/local.properties`, which is gitignored. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- The channel a background FCM notification lands on when the payload
             names none. Must match the channel PushService creates in Dart
             (`jobs`), or Android 8+ drops the notification silently. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="jobs" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Android 11 (API 30) hides other apps from this one unless they are
             declared here. Without these two, `canLaunchUrl` returns false on
             every modern phone and the buttons silently do nothing — the failure
             looks like a bug in our code and is not one.

             `geo:` for the map, `tel:` for the dialler. Deliberately not
             `ACTION_VIEW https` — we are not asking to see the whole browser. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>

        <!-- The handover photo, which is camera-only and has no gallery behind
             it any more: a camera app this app cannot see is a rider who cannot
             finish a delivery. Same Android 11 visibility rule as the two above,
             and `image_picker` ships no `<queries>` of its own.

             Note what is deliberately *not* here: `android.permission.CAMERA`.
             Declaring it would oblige us to request a runtime grant before
             ACTION_IMAGE_CAPTURE; leaving it out means the camera app takes the
             photo under its own permission and hands us back the result. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
    </queries>
</manifest>
