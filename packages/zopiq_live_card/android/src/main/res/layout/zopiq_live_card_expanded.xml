<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded live card body with a large, uncropped artwork pane. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="2dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/zopiq_live_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"/>

        <TextView
            android:id="@+id/zopiq_live_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"/>

        <ImageView
            android:id="@+id/zopiq_live_tracker"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"/>

        <Chronometer
            android:id="@+id/zopiq_live_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"/>

        <TextView
            android:id="@+id/zopiq_live_countdown_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"/>

    </LinearLayout>

    <ImageView
        android:id="@+id/zopiq_live_artwork"
        android:layout_width="116dp"
        android:layout_height="116dp"
        android:layout_marginStart="14dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"/>

</LinearLayout>
